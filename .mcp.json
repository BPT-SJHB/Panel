{
  "mcpServers": {
    "puppeteer": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-puppeteer"]
    },
    "typescript-language-server": {
      "command": "npx",
      "args": ["-y", "typescript-language-server", "--stdio"]
    },
    "angular-cli": {
      "command": "npx",
      "args": ["-y", "@angular/language-server", "--stdio"]
    }
  }
}
